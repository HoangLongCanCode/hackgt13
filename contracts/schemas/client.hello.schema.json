{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ksr.local/contracts/schemas/client.hello.schema.json",
  "title": "client.hello (protocol v2)",
  "description": "Client -> server, the first message after every (re)connect; required for live and sim (a client that sends none is a watcher). The newest hello takes over the session; the previous controller becomes a watcher (perception.error notUplinkClient). Unknown fields are ignored.",
  "type": "object",
  "required": [
    "type",
    "clientId",
    "mode"
  ],
  "additionalProperties": true,
  "properties": {
    "type": {
      "const": "client.hello"
    },
    "protocolVersion": {
      "const": 2
    },
    "clientId": {
      "type": "string",
      "description": "Stable per device, e.g. tab-s9-01."
    },
    "device": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "manufacturer": {
              "type": [
                "string",
                "null"
              ]
            },
            "model": {
              "type": [
                "string",
                "null"
              ]
            },
            "osVersion": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      ]
    },
    "mode": {
      "enum": [
        "video",
        "live",
        "sim"
      ]
    },
    "camera": {
      "description": "live: intrinsics of the UPLINKED, upright image (after rotationDegrees). Nulls = server defaults. focalPx / principalPoint are applied to distances and road anchors, mountHeightMeters replaces the estimated camera height.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "imageWidth",
            "imageHeight"
          ],
          "properties": {
            "imageWidth": {
              "type": "integer",
              "minimum": 1
            },
            "imageHeight": {
              "type": "integer",
              "minimum": 1
            },
            "focalPx": {
              "type": [
                "number",
                "null"
              ],
              "exclusiveMinimum": 0
            },
            "principalPoint": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/point"
                }
              ]
            },
            "mountHeightMeters": {
              "type": [
                "number",
                "null"
              ],
              "exclusiveMinimum": 0
            },
            "pitchDegrees": {
              "type": [
                "number",
                "null"
              ],
              "description": "+ = camera tilted down."
            },
            "lensFacing": {
              "enum": [
                "back",
                "front",
                "external",
                null
              ]
            },
            "stabilization": {
              "type": [
                "boolean",
                "null"
              ],
              "description": "Must be false (stabilisation warps frames)."
            }
          }
        }
      ]
    },
    "sim": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "videoId"
          ],
          "properties": {
            "videoId": {
              "type": "string",
              "description": "Clip stem present on both devices."
            }
          }
        }
      ]
    },
    "navigation": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "enum": [
                "sim",
                "live",
                "off"
              ]
            }
          }
        }
      ],
      "description": "Hint only; the server's CLI flags decide what runs."
    }
  },
  "$defs": {
    "point": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
    }
  }
}
