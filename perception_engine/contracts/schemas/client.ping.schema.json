{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hackgt13.local/contracts/schemas/client.ping.schema.json",
  "title": "client.ping (protocol v2)",
  "description": "Client -> server (optional, ~1 Hz); answered with perception.pong echoing clientTimeNs.",
  "type": "object",
  "required": [
    "type",
    "clientTimeNs"
  ],
  "additionalProperties": true,
  "properties": {
    "type": {
      "const": "client.ping"
    },
    "clientTimeNs": {
      "type": "integer"
    }
  }
}
