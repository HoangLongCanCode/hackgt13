# Copy to perception_engine/.env (gitignored) and fill in. Read by the perception server on the laptop only
# (perception/realtime/tts_proxy.py); the tablet calls POST /tts and never sees the key. ElevenLabs' terms forbid
# API keys in a mobile app.
#
# Voice id: a premade voice works on every plan; a Voice Library voice needs a paid plan (else HTTP 402).
# Check it with: curl http://127.0.0.1:8765/tts/health  (while the server runs)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
