# Copy to spatial/.env (gitignored) and fill in. Read by the laptop only: the phase1 relay that the perception
# server starts loads this file; the tablet never sees the key.
#
# Google Maps Platform key for the phase1 "google" provider. In Google Cloud Console (with billing on), enable the
# Geocoding API and the Routes API for the key's project, and restrict the key to those two APIs.
# Check it with: node spatial/scripts/check-google-key.js "Piedmont Park, Atlanta" 33.7756,-84.3963
GOOGLE_MAPS_API_KEY=

# Optional: routes (default; Routes API computeRoutes, falls back to the legacy API when Routes is not enabled)
# or directions (the legacy Directions API only).
GOOGLE_ROUTES_API=routes
