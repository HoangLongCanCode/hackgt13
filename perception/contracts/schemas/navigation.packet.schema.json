{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ksr.local/contracts/schemas/navigation.packet.schema.json",
  "title": "navigation.packet (protocol v2)",
  "description": "Server -> client navigation message on ws://<host>:8765/perception (PROTOCOL_v2.md, Navigation). The laptop runs the phase1 route engine as a child process (perception_engine/nav/phase1_relay.js) and forwards its SpatialNavigationPacket verbatim in `packet`; `routeState` is the flat subset the AR app's RouteState(time, action, audio, ui) and the Driving Context use. The envelope and routeState are owned by this contract (no extra fields); `packet` is owned by phase1 and may gain fields (additional properties allowed inside it).",
  "type": "object",
  "required": ["type", "schemaVersion", "serverTimeMs", "ptsSeconds", "tripTimestampMs", "routeState", "packet"],
  "additionalProperties": false,
  "properties": {
    "type": { "const": "navigation.packet" },
    "schemaVersion": { "const": 2 },
    "serverTimeMs": { "type": "integer", "description": "Unix epoch ms on the laptop when the message was built." },
    "ptsSeconds": {
      "type": ["number", "null"],
      "description": "sim: the media time (seconds) this packet is for; null in live mode."
    },
    "tripTimestampMs": {
      "type": "integer",
      "description": "Trip clock time of the packet. sim: trip_state[0].timestampMs + 1000 * ptsSeconds (or the session manifest's videoStartTimestampMs + 1000 * ptsSeconds when present). live: timestamp of the newest client.trip_state used (= packet.generatedAtMs)."
    },
    "routeState": { "$ref": "#/$defs/routeState" },
    "packet": { "$ref": "#/$defs/spatialNavigationPacket" }
  },
  "$defs": {
    "geo": {
      "type": "object",
      "required": ["lat", "lng"],
      "properties": {
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lng": { "type": "number", "minimum": -180, "maximum": 180 }
      }
    },
    "eventType": {
      "enum": ["START_ROUTE", "GO_STRAIGHT", "TURN_LEFT", "TURN_RIGHT", "KEEP_LEFT", "KEEP_RIGHT", "MERGE", "EXIT_HIGHWAY", "ARRIVE"]
    },
    "instructionType": {
      "enum": ["TURN_ARROW", "LANE_ARROW", "EXIT_MARKER", "DISTANCE_LABEL", "WARNING"]
    },
    "turnDirection": { "enum": ["left", "right", "straight", "merge", "exit"] },
    "routeState": {
      "type": "object",
      "description": "Derived 1:1 from `packet`; maps onto the AR app's RouteState(time, action, audio, ui).",
      "required": ["action", "audio", "ui", "distanceMeters", "offRoute", "etaSeconds", "remainingDistanceMeters", "requiredLane", "turnDirection", "roadName"],
      "additionalProperties": false,
      "properties": {
        "action": { "$ref": "#/$defs/eventType", "description": "packet.activeManeuver.type (GO_STRAIGHT when the packet has no active maneuver)." },
        "audio": { "type": "string", "description": "packet.audioInstructions[0].content ('' when none)." },
        "ui": { "$ref": "#/$defs/instructionType", "description": "packet.spatialInstructions[0].type (DISTANCE_LABEL when none)." },
        "distanceMeters": {
          "type": ["integer", "null"], "minimum": 0,
          "description": "Metres from the car to the active maneuver along the route (same number phase1 puts in the instruction text); null without an active maneuver."
        },
        "offRoute": { "type": "boolean", "description": "packet.progress.offRoute (> 35 m from the route geometry)." },
        "etaSeconds": { "type": ["integer", "null"], "minimum": 0, "description": "packet.progress.etaSeconds (null when speed <= 0.5 m/s)." },
        "remainingDistanceMeters": { "type": ["number", "null"], "minimum": 0 },
        "requiredLane": { "type": ["string", "null"] },
        "turnDirection": { "oneOf": [{ "$ref": "#/$defs/turnDirection" }, { "type": "null" }] },
        "roadName": { "type": ["string", "null"] }
      }
    },
    "routeStep": {
      "type": "object",
      "required": ["stepId", "instruction", "maneuver", "distanceMeters", "durationSeconds"],
      "properties": {
        "stepId": { "type": "string" },
        "instruction": { "type": "string" },
        "maneuver": { "enum": ["start", "straight", "left", "right", "keep_left", "keep_right", "merge", "exit", "arrive"] },
        "distanceMeters": { "type": "number", "minimum": 0 },
        "durationSeconds": { "type": "number", "minimum": 0 },
        "roadName": { "type": ["string", "null"] },
        "exitNumber": { "type": ["string", "number", "null"] },
        "requiredLane": { "type": ["string", "null"] },
        "polyline": { "type": ["string", "null"] }
      }
    },
    "navigationEvent": {
      "type": "object",
      "required": ["eventId", "type", "distanceMeters"],
      "properties": {
        "eventId": { "type": "string" },
        "type": { "$ref": "#/$defs/eventType" },
        "distanceMeters": { "type": "number", "minimum": 0, "description": "Route distance (m from the route start) where the event happens." },
        "roadName": { "type": ["string", "null"] },
        "exitNumber": { "type": ["string", "number", "null"] },
        "requiredLane": { "type": ["string", "null"] },
        "instruction": { "type": ["string", "null"] },
        "priority": { "type": "integer", "minimum": 1 }
      }
    },
    "spatialInstruction": {
      "type": "object",
      "required": ["id", "type", "anchor", "content", "priority", "lifetimeMs"],
      "properties": {
        "id": { "type": "string" },
        "type": { "$ref": "#/$defs/instructionType" },
        "anchor": {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": { "enum": ["ROAD", "ROUTE_POINT", "SCREEN"] },
            "x": { "type": "number" },
            "y": { "type": "number" },
            "routeDistanceMeters": { "type": "number" }
          }
        },
        "content": { "type": "string" },
        "priority": { "type": "integer", "minimum": 1 },
        "lifetimeMs": { "type": "integer", "minimum": 0 }
      }
    },
    "audioInstruction": {
      "type": "object",
      "required": ["id", "content", "priority"],
      "properties": {
        "id": { "type": "string" },
        "content": { "type": "string" },
        "priority": { "type": "integer", "minimum": 1 },
        "speakAtDistanceMeters": { "type": "number" }
      }
    },
    "spatialNavigationPacket": {
      "type": "object",
      "description": "phase1 SpatialNavigationPacket, verbatim (src/phase1/processor.js buildSpatialNavigationPacket; docs/PHASE_1_SPATIAL_NAVIGATION_SPEC.md section 3). Optional fields that phase1 leaves undefined are absent.",
      "required": ["packetType", "tripId", "routeId", "generatedAtMs", "source", "destination", "progress", "route", "upcomingManeuvers", "spatialInstructions", "audioInstructions", "routeSemantics", "handoffHints"],
      "properties": {
        "packetType": { "const": "SPATIAL_NAVIGATION_PACKET" },
        "tripId": { "type": "string", "description": "session_manifest.json sessionId (live: live_<epoch ms>)." },
        "routeId": { "type": "string" },
        "generatedAtMs": { "type": "integer", "description": "timestampMs of the newest trip-state sample used." },
        "source": {
          "type": "object",
          "required": ["provider"],
          "properties": {
            "provider": { "type": "string" },
            "routeApiVersion": { "type": ["string", "null"] }
          }
        },
        "destination": {
          "type": "object",
          "required": ["label", "coordinate"],
          "properties": {
            "label": { "type": "string" },
            "placeId": { "type": ["string", "null"] },
            "coordinate": { "$ref": "#/$defs/geo" }
          }
        },
        "progress": {
          "type": "object",
          "required": ["currentLocation", "heading", "speedMps", "routeIndex", "distanceTraveledMeters", "remainingDistanceMeters", "etaSeconds", "offRoute"],
          "properties": {
            "currentLocation": { "$ref": "#/$defs/geo" },
            "heading": { "type": "number" },
            "speedMps": { "type": "number", "minimum": 0 },
            "routeIndex": { "type": "integer", "minimum": 0 },
            "distanceTraveledMeters": { "type": "number", "minimum": 0 },
            "remainingDistanceMeters": { "type": "number", "minimum": 0 },
            "etaSeconds": { "type": ["integer", "null"], "minimum": 0 },
            "offRoute": { "type": "boolean" }
          }
        },
        "route": {
          "type": "object",
          "required": ["polyline", "steps", "totalDistanceMeters", "totalDurationSeconds"],
          "properties": {
            "polyline": { "type": "string", "description": "Encoded polyline (Google); '' for the mock provider." },
            "steps": { "type": "array", "items": { "$ref": "#/$defs/routeStep" } },
            "totalDistanceMeters": { "type": "number", "minimum": 0 },
            "totalDurationSeconds": { "type": "number", "minimum": 0 }
          }
        },
        "activeManeuver": { "$ref": "#/$defs/navigationEvent" },
        "upcomingManeuvers": { "type": "array", "items": { "$ref": "#/$defs/navigationEvent" } },
        "spatialInstructions": { "type": "array", "items": { "$ref": "#/$defs/spatialInstruction" } },
        "audioInstructions": { "type": "array", "items": { "$ref": "#/$defs/audioInstruction" } },
        "routeSemantics": {
          "type": "object",
          "properties": {
            "roadName": { "type": ["string", "null"] },
            "highwayName": { "type": ["string", "null"] },
            "exitNumber": { "type": ["string", "number", "null"] },
            "requiredLane": { "type": ["string", "null"] },
            "turnDirection": { "oneOf": [{ "$ref": "#/$defs/turnDirection" }, { "type": "null" }] }
          }
        },
        "handoffHints": {
          "type": "object",
          "required": ["confidence", "displayPriority", "staleAfterMs"],
          "properties": {
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
            "displayPriority": { "type": "integer", "minimum": 1 },
            "staleAfterMs": { "type": "integer", "minimum": 0 }
          }
        }
      }
    }
  }
}
