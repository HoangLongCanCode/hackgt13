{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ksr.local/contracts/perception_frame.v1.schema.json",
  "title": "PerceptionFrame v1",
  "description": "One realtime message from the Perception Engine (Python, GPU) to the Driving Context Engine (Kotlin, glasses/phone). Sent as a WebSocket text frame; never written to disk in realtime mode. Coordinates are source-image pixels (origin top-left). Units are in field names.",
  "type": "object",
  "required": ["type", "schemaVersion", "seq", "sessionId", "source", "frameIndex", "ptsSeconds", "serverTimeMs", "processingMs", "image", "camera", "objects", "signs", "blockAges", "timingsMs"],
  "additionalProperties": false,
  "properties": {
    "type": { "const": "perception.frame" },
    "schemaVersion": { "const": 1 },
    "seq": { "type": "integer", "minimum": 0, "description": "Monotonic per session; gaps = frames dropped to stay realtime." },
    "sessionId": { "type": "string" },
    "source": {
      "type": "object",
      "required": ["kind", "id"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["video", "camera", "replay"] },
        "id": { "type": "string" }
      }
    },
    "frameIndex": { "type": "integer", "minimum": 0 },
    "ptsSeconds": { "type": "number", "description": "Media time of the analysed frame. Sync AR overlays / HTML5 video by this, not by arrival time." },
    "serverTimeMs": { "type": "integer", "description": "Unix epoch ms when the message was sent." },
    "processingMs": { "type": "number", "description": "Frame grabbed -> message sent, on the server." },
    "image": {
      "type": "object",
      "required": ["width", "height"],
      "additionalProperties": false,
      "properties": { "width": { "type": "integer" }, "height": { "type": "integer" } }
    },
    "camera": {
      "type": "object",
      "description": "Assumed/estimated pinhole camera, so the AR renderer can project ground points.",
      "required": ["focalPx", "principalPoint"],
      "additionalProperties": false,
      "properties": {
        "focalPx": { "type": "number" },
        "principalPoint": { "$ref": "#/$defs/point" },
        "horizonY": { "type": ["number", "null"] },
        "cameraHeightMeters": { "type": ["number", "null"] }
      }
    },
    "objects": { "type": "array", "items": { "$ref": "#/$defs/perceivedObject" } },
    "signs": { "type": "array", "items": { "$ref": "#/$defs/sign" } },
    "lanes": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/lanes" }] },
    "road": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/road" }] },
    "blockAges": {
      "type": "object",
      "description": "Frames since each scheduled block last ran (0 = ran on this frame). Lets the consumer judge freshness.",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "timingsMs": { "type": "object", "additionalProperties": { "type": "number" } }
  },
  "$defs": {
    "point": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
    "bbox": { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4, "description": "[x1, y1, x2, y2] px" },
    "polyline": { "type": "array", "items": { "$ref": "#/$defs/point" } },
    "perceivedObject": {
      "type": "object",
      "description": "One tracked object with everything known about it fused by track id (plan §7 detection + §8 motion + §9 distance + §11 light state).",
      "required": ["id", "class", "bbox", "confidence", "ageFrames"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "integer", "description": "Track id, stable across frames (plan §8)." },
        "class": { "enum": ["pedestrian", "rider", "car", "truck", "bus", "train", "motorcycle", "bicycle", "traffic light", "traffic sign"] },
        "bbox": { "$ref": "#/$defs/bbox" },
        "confidence": { "type": "number" },
        "ageFrames": { "type": "integer" },
        "distanceMeters": { "type": ["number", "null"] },
        "distanceMethod": { "type": ["string", "null"] },
        "distanceConfidence": { "type": ["number", "null"] },
        "lateralMeters": { "type": ["number", "null"], "description": "+ = right of camera axis." },
        "ttcSeconds": { "type": ["number", "null"], "description": "Time to collision from box scale change; null when not closing." },
        "approaching": { "type": ["boolean", "null"] },
        "inEgoPath": { "type": ["boolean", "null"], "description": "Box bottom inside the ego path / ego lane polygon." },
        "lightState": { "enum": ["RED", "YELLOW", "GREEN", "UNKNOWN", null], "description": "Only for class 'traffic light'." },
        "lightConfidence": { "type": ["number", "null"] }
      }
    },
    "sign": {
      "type": "object",
      "required": ["signClass", "bbox", "confidence"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": ["integer", "null"] },
        "signClass": { "type": "string", "description": "e.g. stop, yield, doNotEnter, speedLimit45, pedestrianCrossing" },
        "bbox": { "$ref": "#/$defs/bbox" },
        "confidence": { "type": "number" },
        "distanceMeters": { "type": ["number", "null"] }
      }
    },
    "lanes": {
      "type": "object",
      "description": "Plan §10. Lanes numbered 1..laneCount from the left.",
      "required": ["currentLane", "laneCount", "laneBoundaries", "confidence"],
      "additionalProperties": false,
      "properties": {
        "currentLane": { "type": ["integer", "null"] },
        "laneCount": { "type": ["integer", "null"] },
        "laneBoundaries": { "type": "array", "items": { "$ref": "#/$defs/polyline" }, "description": "Left to right, <= 20 points each." },
        "confidence": { "type": "number" }
      }
    },
    "road": {
      "type": "object",
      "description": "Plan §13: where AR content can be anchored.",
      "required": ["drivableCoverage", "egoPathPolygon", "anchorPoints"],
      "additionalProperties": false,
      "properties": {
        "drivableCoverage": { "type": "number" },
        "egoPathPolygon": { "$ref": "#/$defs/polyline" },
        "horizonY": { "type": ["number", "null"] },
        "vanishingPoint": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/point" }] },
        "anchorPoints": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "xy", "valid"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "description": "e.g. ego_path_10m, ego_path_20m, ego_path_40m" },
              "xy": { "$ref": "#/$defs/point" },
              "groundXZ": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/point" }], "description": "[lateral m, forward m] on the ground plane" },
              "valid": { "type": "boolean" }
            }
          }
        }
      }
    }
  }
}
